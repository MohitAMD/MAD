# CONTEXT {'gpu_vendor': 'AMD', 'guest_os': 'UBUNTU'}
# NOTE: no `# syntax=` directive on purpose — the daemon's built-in BuildKit
# frontend supports heredocs + COPY --from without pulling docker/dockerfile
# from Docker Hub (avoids the registry-auth 401 on locked-down build hosts).
# =============================================================================
# GLM-5.1-FP8 — Disaggregated (WideEP) serving on AMD MI300X (gfx942)
# SINGLE build command — layers the WideEP stack on the single-node base.
#
# One `docker build` produces the full WideEP image. It does NOT rebuild
# PyTorch/vLLM/FlashAttention from source (~2-4 h). Instead it:
#   STAGE sn_base : reproduces the single-node aiter017 recipe INLINE
#                   (FROM vllm/vllm-openai-rocm:v0.25.1 + PR#47766 + aiter
#                    v0.1.17-longctx). This is the "base image" — built here if
#                    not supplied. Its layers are cached, so it is built ONCE and
#                    reused on every subsequent overlay rebuild.
#   STAGE triton  : rebuilds Triton (ROCm/triton@0f380657 + cherry-pick 555d04f
#                    = triton#8991, the AMD M=1 fix the base's stock 3.6.0 lacks).
#   STAGE mori    : builds amd_mori @ 42e895472b08 (the from-scratch recipe pin).
#   STAGE final   : installs those wheels + the WideEP Stage-9 overlay patches.
#
# The single-node base ships the exact expensive pins already (verified:
#   ROCm 7.2.3 · PyTorch 2.11.0+gitd0c8b1f · vLLM 0.25.1), so only Triton, MoRI,
#   the router, and the disagg patches are (re)built here. Total ~40-60 min vs
#   ~2-4 h from scratch.
#
# ── SINGLE BUILD COMMAND ─────────────────────────────────────────────────────
#   cd /path/to/MAD-fork          # the repo root (build context)
#   DOCKER_BUILDKIT=1 docker build \
#     -f docker/Dockerfile.glm51_v025_aiter017longctx_wideep \
#     -t vllm-glm51-v025-aiter017longctx-wideep:latest .
#
#   (Optional) skip building the base by reusing a prebuilt single-node image:
#     ... --build-arg SN_IMAGE=vllm-glm51-v025-aiter017longctx:latest
#   SN_IMAGE defaults to the internal `sn_base` stage, so with no override the
#   base is built inline; with an override the inline build is skipped entirely.
#
# Build context MUST be the MAD-fork repo root (so COPY docker/patches/... work).
# =============================================================================

# ---- base / rebase selection ------------------------------------------------
ARG BASE_IMAGE=vllm/vllm-openai-rocm:v0.25.1
# SN_IMAGE = what the triton/mori/final stages build FROM. Defaults to the
# internal `sn_base` stage (built inline below). Override with a prebuilt
# single-node aiter017 image tag to skip the inline base build.
ARG SN_IMAGE=sn_base

# ---- single-node base pins (match Dockerfile.glm51_v025_aiter017longctx) -----
ARG AITER_REV=v0.1.17-longctx
ARG AITER_COMMIT=5f930ea50a36abd214d8710c801f95ca01efdd67
ARG AITER_SCM_VERSION=0.1.17+longctx

# ---- WideEP-delta pins (match the from-scratch recipe) ----------------------
ARG TRITON_REPO="https://github.com/ROCm/triton.git"
ARG TRITON_BRANCH="0f380657"
ARG TRITON_CHERRYPICK="555d04f"
ARG MORI_REPO="https://github.com/ROCm/mori.git"
ARG MORI_REF="42e895472b08"

# =============================================================================
# STAGE sn_base — single-node aiter017 base, built INLINE (the "base image").
#   Byte-equivalent to v0.25.1_AITER_0.1.17_Release/Dockerfile.glm51_v025_aiter017longctx:
#   vllm/vllm-openai-rocm:v0.25.1 + PR#47766 + aiter v0.1.17-longctx@5f930ea5.
#   Skipped entirely if --build-arg SN_IMAGE=<prebuilt tag> is passed.
# =============================================================================
FROM ${BASE_IMAGE} AS sn_base
ARG AITER_REV
ARG AITER_COMMIT
ARG AITER_SCM_VERSION

# ── PR#47766 — sparse MLA metadata key fix (4->6 fields) ────────────────────
# Heredoc uses <<'PYEOF' with NO space before the delimiter (BuildKit rejects
# the spaced form with "unknown instruction: import").
RUN python3 - <<'PYEOF'
import importlib.util, os, sys
vllm_root = os.path.dirname(os.path.dirname(importlib.util.find_spec('vllm').origin))
f = os.path.join(vllm_root, 'vllm/v1/attention/backends/mla/rocm_aiter_mla_sparse.py')
with open(f) as fh:
    src = fh.read()
if 'clamped_context_lens.tobytes()' in src:
    print('[OK] PR#47766 already applied — skipping'); sys.exit(0)
old = '''        clamped_seq_lens = np.minimum(
            common_attn_metadata.seq_lens_cpu[:num_reqs].numpy(),
            self.topk_tokens,
        )
        metadata_key = (
            num_tokens,
            int(common_attn_metadata.max_query_len),
            self._num_attention_heads,
            clamped_seq_lens.tobytes(),
        )'''
new = '''        clamped_seq_lens = np.minimum(
            common_attn_metadata.seq_lens_cpu[:num_reqs].numpy(),
            self.topk_tokens,
        )
        seg_lengths = np.diff(
            np.asarray(common_attn_metadata.query_start_loc_cpu, dtype=np.int32)
        )
        clamped_context_lens = np.minimum(
            common_attn_metadata.seq_lens_cpu[:num_reqs].numpy() - seg_lengths,
            self.topk_tokens,
        )
        metadata_key = (
            num_tokens,
            int(common_attn_metadata.max_query_len),
            self._num_attention_heads,
            clamped_seq_lens.tobytes(),
            clamped_context_lens.tobytes(),
            seg_lengths.tobytes(),
        )'''
if old not in src:
    print('ERROR: PR#47766 anchor not found — base image file structure changed'); sys.exit(1)
open(f, 'w').write(src.replace(old, new, 1))
print('[OK] PR#47766 applied — 6-field metadata key')
PYEOF
RUN python3 -c "\
import importlib.util, os; \
vr = os.path.dirname(os.path.dirname(importlib.util.find_spec('vllm').origin)); \
s = open(os.path.join(vr,'vllm/v1/attention/backends/mla/rocm_aiter_mla_sparse.py')).read(); \
assert 'clamped_context_lens.tobytes()' in s and 'seg_lengths.tobytes()' in s, 'PR#47766 FAILED'; \
print('[OK] PR#47766 verified')"

# ── AITER v0.1.17-longctx (from git; the slow base step, cached after 1st build)
RUN pip uninstall -y amd_aiter amd-aiter aiter 2>/dev/null || true && \
    if [ -n "${AITER_SCM_VERSION}" ]; then export SETUPTOOLS_SCM_PRETEND_VERSION="${AITER_SCM_VERSION}"; fi && \
    pip install "git+https://github.com/ROCm/aiter.git@${AITER_REV}" && \
    pip show amd-aiter | grep -i version
# Assert the exact commit (guards a moved tag) via the wheel's direct_url.json.
RUN AITER_COMMIT="${AITER_COMMIT}" python3 - <<'PYEOF'
import glob, importlib.util, json, os
expected = os.environ['AITER_COMMIT']
aiter_root = os.path.dirname(importlib.util.find_spec('aiter').origin)
actual = None
for p in glob.glob(os.path.join(os.path.dirname(aiter_root), 'amd_aiter-*.dist-info', 'direct_url.json')):
    actual = json.load(open(p)).get('vcs_info', {}).get('commit_id')
assert actual == expected, f'AITER commit mismatch: got {actual}, expected {expected}'
print('[OK] aiter commit', expected, '(CK af7118e3 — confirm on-GPU with the zero-output probe before shipping)')
PYEOF

# =============================================================================
# STAGE triton — ROCm triton @ 0f380657 + cherry-pick 555d04f (triton#8991)
#   The base's upstream Triton 3.6.0 lacks the M=1 canonicalizePointers fix
#   (first in v3.7.0). Disagg decode is DP=8/TP=1 => qseqlen=1 => M=1, the exact
#   trigger, so rebuild the from-scratch triton with the fix.
# =============================================================================
FROM ${SN_IMAGE} AS triton_build
ARG TRITON_REPO
ARG TRITON_BRANCH
ARG TRITON_CHERRYPICK
RUN pip install -U "cmake<4" ninja wheel build packaging pybind11 2>&1 | tail -3
RUN git clone ${TRITON_REPO} /tmp/triton
RUN cd /tmp/triton \
    && git checkout ${TRITON_BRANCH} \
    && git config --global user.email "build@local" && git config --global user.name "build" \
    && git cherry-pick ${TRITON_CHERRYPICK} \
    && git log -1 --oneline \
    && if [ ! -f setup.py ]; then cd python; fi \
    && python3 setup.py bdist_wheel --dist-dir=/app/install \
    && ls -l /app/install/*.whl
RUN if [ -d /tmp/triton/python/triton_kernels ]; then \
      cd /tmp/triton/python/triton_kernels && python3 -m build --wheel \
      && cp dist/*.whl /app/install/ 2>/dev/null || true; \
    fi; ls -l /app/install/*.whl

# =============================================================================
# STAGE mori — amd_mori @ 42e895472b08 (the from-scratch recipe pin)
# =============================================================================
FROM ${SN_IMAGE} AS mori_build
ARG MORI_REPO
ARG MORI_REF
ENV MORI_GPU_ARCHS=gfx942 BUILD_UMBP=OFF BUILD_UMBP_SPDK=OFF
RUN pip install -U "cmake<4" ninja wheel "setuptools_scm[toml]>=6.2" 2>&1 | tail -3
RUN git clone --recursive ${MORI_REPO} /tmp/mori
RUN cd /tmp/mori \
    && git checkout ${MORI_REF} \
    && git fetch --tags --force \
    && git submodule update --init --recursive \
    && python3 setup.py bdist_wheel --dist-dir=/app/install \
    && ls -l /app/install/*.whl \
    && case "$(ls /app/install/*.whl)" in \
         *-0.0.0-*|*-0.1.0-*) echo "ERROR: mori scm version unresolved ($(ls /app/install/*.whl))" >&2; exit 1;; \
       esac

# =============================================================================
# STAGE final — base + rebuilt triton + pinned mori + WideEP Stage-9 overlay
# =============================================================================
FROM ${SN_IMAGE} AS final
ENTRYPOINT []
WORKDIR /app
ARG MORI_REF
ARG TRITON_BRANCH
ARG TRITON_CHERRYPICK
RUN mkdir -p /app && echo "GLM-5.1-FP8 WideEP — layered on single-node aiter017 (triton ${TRITON_BRANCH}+${TRITON_CHERRYPICK}/triton#8991, mori ${MORI_REF}); inherits torch2.11.0+d0c8b1f / vLLM0.25.1 / aiter v0.1.17-longctx / PR#47766" >> /app/versions.txt

# --- install the rebuilt triton (over the base's 3.6.0) + the pinned mori ------
# COPY --from (portable, no BuildKit syntax frontend needed) instead of --mount.
COPY --from=triton_build /app/install/ /tmp/wheels_t/
COPY --from=mori_build /app/install/ /tmp/wheels_m/
RUN pip install --no-deps --force-reinstall /tmp/wheels_t/*.whl \
    && pip install --no-deps --force-reinstall /tmp/wheels_m/*.whl \
    && python3 -c "import triton; print('triton', triton.__version__, '(rebuilt w/ triton#8991)')" \
    && python3 -c "import mori, mori.io, mori.ops; print('mori OK')" \
    && rm -rf /tmp/wheels_t /tmp/wheels_m \
    && echo "REBASE: triton ${TRITON_BRANCH}+${TRITON_CHERRYPICK} (triton#8991) + mori @ ${MORI_REF} installed" >> /app/versions.txt

# --- 0) MoRIIO KV-connector + WideEP proxy runtime deps -----------------------
RUN pip install --no-cache-dir --ignore-installed blinker \
    && pip install --no-cache-dir msgpack quart aiohttp pyzmq \
    && python3 -c "import msgpack, quart, aiohttp, zmq; print('MoRIIO proxy deps OK')" \
    && echo "PATCH: MoRIIO/WideEP runtime deps (msgpack quart aiohttp pyzmq blinker)" >> /app/versions.txt

# --- 1) PR#47766 (idempotent; inherited from sn_base — verify/no-op) ----------
COPY docker/patches/patch_pr47766_v024.py /tmp/patch_pr47766.py
RUN python3 /tmp/patch_pr47766.py && \
    ROCM_SPARSE=$(python3 -c "import importlib.util,os;print(os.path.join(os.path.dirname(importlib.util.find_spec('vllm').origin),'v1/attention/backends/mla/rocm_aiter_mla_sparse.py'))") && \
    grep -q 'clamped_context_lens.tobytes()' "$ROCM_SPARSE" && grep -q 'seg_lengths.tobytes()' "$ROCM_SPARSE" && \
    python3 -m py_compile "$ROCM_SPARSE" && \
    echo "PATCH: PR#47766 (6-field sparse-MLA metadata key) present" >> /app/versions.txt && \
    rm -f /tmp/patch_pr47766.py

# --- 1b) cold-start fixes: DSA indexer boot-warmup + scheduler stale-req guard -
COPY docker/patches/apply_glm_dsa_indexer_warmup_fix.py /tmp/patch_dsa_warmup.py
RUN VLLM_DIR=$(python3 -c "import importlib.util,os;print(os.path.dirname(importlib.util.find_spec('vllm').origin))") && \
    python3 /tmp/patch_dsa_warmup.py "$VLLM_DIR" \
      && echo "PATCH: GLM DSA indexer boot-warmup" >> /app/versions.txt \
      || echo "WARN: DSA indexer warmup patch did not apply" >> /app/versions.txt; \
    rm -f /tmp/patch_dsa_warmup.py
COPY docker/patches/patch_glm_sched_kv_xfer_stale_guard.py /tmp/patch_sched_guard.py
RUN python3 /tmp/patch_sched_guard.py \
      && echo "PATCH: scheduler KV-xfer stale-req guard" >> /app/versions.txt \
      || echo "WARN: scheduler stale-req guard did not apply" >> /app/versions.txt; \
    rm -f /tmp/patch_sched_guard.py

# --- 1c) cold-JIT multi-decode (2P2D+) bring-up: honor VLLM_HANDSHAKE_TIMEOUT_MINS
RUN VLLM_CORE=$(python3 -c "import importlib.util,os;print(os.path.join(os.path.dirname(importlib.util.find_spec('vllm').origin),'v1/engine/core.py'))") && \
    sed -i -E 's/^([[:space:]]*)HANDSHAKE_TIMEOUT_MINS[[:space:]]*=.*/\1HANDSHAKE_TIMEOUT_MINS = int(__import__("os").environ.get("VLLM_HANDSHAKE_TIMEOUT_MINS", "5"))/' "$VLLM_CORE" \
      && grep -q 'VLLM_HANDSHAKE_TIMEOUT_MINS' "$VLLM_CORE" && python3 -m py_compile "$VLLM_CORE" \
      && echo "PATCH: VLLM_HANDSHAKE_TIMEOUT_MINS env-configurable" >> /app/versions.txt \
      || echo "WARN: handshake-timeout patch did not apply" >> /app/versions.txt

# --- 2) vllm-router (WideEP disagg proxy, DP-rank round-robin) ----------------
ARG WITH_ROUTER=1
ARG ROUTER_REPO=https://github.com/raviguptaamd/router.git
ARG ROUTER_REF=ravgupta/discovery-dp-rank-roundrobin
ARG RUST_TOOLCHAIN=1.88.0
RUN if [ "${WITH_ROUTER}" != "1" ]; then \
      echo "WITH_ROUTER=0: skipping vllm-router" | tee -a /app/versions.txt; \
    else set -e && \
      ( for F in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
          [ -f "$F" ] && sed -i -e 's|http://archive.ubuntu.com/ubuntu|https://iad-ad-1.clouds.archive.ubuntu.com/ubuntu|g' \
                                -e 's|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' "$F"; \
        done 2>/dev/null || true; \
        apt-get update -y || true; \
        apt-get install -y --no-install-recommends libssl-dev pkg-config || true; \
        rm -rf /var/lib/apt/lists/* ) && \
      export PATH="/root/.cargo/bin:${PATH}" && \
      if ! command -v cargo >/dev/null 2>&1; then \
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_TOOLCHAIN}"; \
      fi && \
      rm -rf /tmp/vllm-router-src && \
      git clone --filter=blob:none "${ROUTER_REPO}" /tmp/vllm-router-src && \
      cd /tmp/vllm-router-src && git checkout "${ROUTER_REF}" && \
      cargo build --release && \
      install -m 755 target/release/vllm-router /usr/local/bin/vllm-router && \
      vllm-router --help 2>&1 | grep -q moriio && \
      echo "VLLM_ROUTER_REF=${ROUTER_REF}@$(git -C /tmp/vllm-router-src rev-parse HEAD)" >> /app/versions.txt && \
      rm -rf /tmp/vllm-router-src; \
    fi

# --- 3) rocm.py GCN-arch circular-import boot fix (best-effort) ---------------
RUN ROCM_PY=$(python3 -c "import importlib.util,os;print(os.path.join(os.path.dirname(importlib.util.find_spec('vllm').origin),'platforms/rocm.py'))") && \
    test -f "$ROCM_PY" && \
    sed -i 's/logger\.warning_once(/logger.warning(/g' "$ROCM_PY" && \
    sed -i 's#return torch\.cuda\.get_device_properties("cuda")\.gcnArchName#return __import__("os").environ.get("VLLM_GCN_ARCH", "gfx942")#' "$ROCM_PY" && \
    python3 -m py_compile "$ROCM_PY" && \
    echo "PATCH: rocm.py GCN-arch circular-import fix (best-effort)" >> /app/versions.txt

# --- 4) PATCH A — aiter MLA dispatch: fold gfx942 gqa64 fp8 decode qh64 -> qh16
COPY docker/patches/patch_aiter_mla_qh64_fold.py /tmp/patch_aiter_qh64.py
RUN python3 /tmp/patch_aiter_qh64.py && \
    echo "PATCH A: aiter gfx942 gqa64 fp8 decode folds to qh16 (avoids #3188 qh64 page_size=1 OOB)" >> /app/versions.txt && \
    rm -f /tmp/patch_aiter_qh64.py

# --- 5) PATCH B — vLLM sparse-MLA: force use_persistent=True for gqa64 --------
COPY docker/patches/patch_glm_dsa_force_persistent.py /tmp/patch_force_persistent.py
RUN python3 /tmp/patch_force_persistent.py && \
    echo "PATCH B: vLLM sparse-MLA use_persistent forced True (gqa64 fp8 needs persistent; rely on PR#47766)" >> /app/versions.txt && \
    rm -f /tmp/patch_force_persistent.py

# --- 6) cache locations + JIT scrub so kernels recompile against patched dispatch
ENV AITER_JIT_DIR=/opt/vllm_cache/aiter_jit \
    VLLM_CACHE_ROOT=/opt/vllm_cache/vllm \
    TRITON_CACHE_DIR=/opt/vllm_cache/triton \
    COMGR_CACHE_DIR=/opt/vllm_cache/comgr
RUN rm -rf /opt/vllm_cache/aiter_jit /root/.aiter /root/.mori /tmp/mori_jit_* /tmp/vllm_cache*/aiter_jit 2>/dev/null || true; \
    mkdir -p /root/.mori && echo "JIT_SCRUBBED" >> /app/versions.txt
# GPU-less build node: import vllm + mori (both proven importable without a GPU);
# aiter is intentionally NOT imported here (it JIT-builds + shells to rocminfo).
RUN python3 -c "import vllm, mori, mori.io, mori.ops; print('import OK: vllm', vllm.__version__, '+ MoRI (aiter@runtime)')"
RUN cat /app/versions.txt 2>/dev/null | tail -40 || true

# Runtime (set by the launcher):
#   VLLM_ROCM_USE_AITER=1  VLLM_GCN_ARCH=gfx942  VLLM_HANDSHAKE_TIMEOUT_MINS=30
#   Disagg: prefill DP=8 TP=1 + decode DP=8 TP=1 (EP8 per role; EP16 for 2P2D)
#   KV connector: MoRIIO (mori.io)   Router: vllm-router (DP-rank round-robin)
#   Serve containers must use --network host.
# =============================================================================
